---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import pricing from '../../../pricing.json';

const free = pricing.tiers.find((t) => t.id === 'free')!;
const premium = pricing.tiers.find((t) => t.id === 'premium_monthly')!;
const yearly = pricing.tiers.find((t) => t.id === 'premium_yearly')!;
const contactEmail = pricing.contact_email as string;

const formatPrice = (n: number, currency: string) => {
  if (n === 0) return '0 đ';
  if (currency === 'VND') {
    if (n >= 1_000_000) {
      const v = (n / 1_000_000).toFixed(2).replace(/\.00$/, '').replace('.', ',');
      return `${v} triệu`;
    }
    return `${Math.round(n / 1_000)}K`;
  }
  return n.toLocaleString('en-US');
};
---
<BaseLayout
  seo={{ title: 'Gói học — Free vs Premium', description: `HocVui miễn phí 50 bài/ngày. Premium mở khóa không giới hạn và báo cáo nâng cao.`, path: '/pricing' }}
  locale="vi"
  pageJsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: 'HocVui Premium',
      description: 'Mở khóa không giới hạn bài học, báo cáo tiến bộ, nhiều hồ sơ bé.',
      brand: { '@type': 'Brand', name: 'HocVui' },
      offers: [
        { '@type': 'Offer', price: String(free.price), priceCurrency: pricing.currency, name: free.name_vi, availability: 'https://schema.org/InStock' },
        { '@type': 'Offer', price: String(premium.price), priceCurrency: pricing.currency, name: `${premium.name_vi} (tháng)`, availability: 'https://schema.org/InStock' },
        { '@type': 'Offer', price: String(yearly.price), priceCurrency: pricing.currency, name: `${yearly.name_vi} (năm)`, availability: 'https://schema.org/InStock' },
      ],
    },
  ]}
>
  <Header slot="nav" locale="vi" currentPath="/pricing" />
  <Fragment slot="footer"><Footer locale="vi" /></Fragment>

  <section class="bg-gradient-to-b from-pink-soft to-pink-bg py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-4xl font-extrabold text-purple-deep sm:text-5xl">Gói học</h1>
      <p class="mt-3 text-lg text-purple-deep/70">Bắt đầu miễn phí. Nâng cấp khi cần.</p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-3">
      <!-- Free -->
      <div class="rounded-3xl border-2 border-pink-soft bg-white p-8">
        <p class="text-sm font-bold uppercase tracking-wider text-pink-dark">{free.name_vi}</p>
        <p class="mt-2 font-display text-5xl font-extrabold text-purple-deep">{formatPrice(free.price, pricing.currency)}</p>
        <p class="text-sm text-purple-deep/60">{free.price_period_vi}</p>
        <ul class="mt-6 space-y-3 text-sm">
          {free.features.map((f) => (
            <li class="flex items-start gap-2 text-purple-deep/80">
              <span class="mt-0.5 text-success">✓</span>
              <span>{f.text_vi}</span>
            </li>
          ))}
        </ul>
        <a
          href="/app"
          class="mt-8 block w-full rounded-full border-2 border-pink bg-white py-3 text-center text-sm font-bold text-pink-dark transition hover:bg-pink-soft"
        >Bắt đầu miễn phí</a>
      </div>

      <!-- Premium monthly -->
      <div class="relative rounded-3xl border-4 border-pink bg-gradient-to-br from-pink-bg to-cream p-8 shadow-chunky">
        {premium.popular && <span class="absolute -top-3 right-6 rounded-full bg-pink px-3 py-1 text-xs font-bold uppercase text-white">Phổ biến</span>}
        <p class="text-sm font-bold uppercase tracking-wider text-pink-dark">{premium.name_vi}</p>
        <p class="mt-2 font-display text-5xl font-extrabold text-purple-deep">{formatPrice(premium.price, pricing.currency)}<span class="text-lg">{premium.price_period_vi}</span></p>
        <p class="text-sm text-purple-deep/60">{formatPrice(yearly.price, pricing.currency)} {yearly.price_period_vi} (tiết kiệm 17%)</p>
        <ul class="mt-6 space-y-3 text-sm">
          {premium.features.map((f) => (
            <li class="flex items-start gap-2 text-purple-deep/80">
              <span class="mt-0.5 text-pink-dark">✓</span>
              <span>{f.text_vi}</span>
            </li>
          ))}
        </ul>
        <a
          href="/app"
          class="mt-8 block w-full rounded-full bg-pink py-3 text-center text-sm font-bold text-white shadow-pill transition hover:bg-pink-dark"
        >Nâng cấp ngay</a>
        <p class="mt-3 text-center text-xs text-purple-deep/60">Huỷ bất cứ lúc nào. Hoàn tiền trong 7 ngày.</p>
      </div>

      <!-- Premium yearly -->
      <div class="rounded-3xl border-2 border-pink-soft bg-cream p-8">
        <p class="text-sm font-bold uppercase tracking-wider text-pink-dark">{yearly.name_vi}</p>
        <p class="mt-2 font-display text-5xl font-extrabold text-purple-deep">{formatPrice(yearly.price, pricing.currency)}<span class="text-lg">{yearly.price_period_vi}</span></p>
        <p class="text-sm text-success">Tiết kiệm 17% so với trả theo tháng</p>
        <ul class="mt-6 space-y-3 text-sm">
          {yearly.features.map((f) => (
            <li class="flex items-start gap-2 text-purple-deep/80">
              <span class="mt-0.5 text-pink-dark">✓</span>
              <span>{f.text_vi}</span>
            </li>
          ))}
        </ul>
        <a
          href="/app"
          class="mt-8 block w-full rounded-full border-2 border-pink bg-white py-3 text-center text-sm font-bold text-pink-dark transition hover:bg-pink-soft"
        >Tiết kiệm ngay</a>
      </div>
    </div>

    <!-- Comparison table -->
    <div class="mt-12 rounded-3xl border-2 border-pink-soft bg-white p-6">
      <h2 class="text-center font-display text-2xl font-extrabold text-purple-deep">So sánh chi tiết</h2>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b-2 border-pink-soft">
              <th class="py-3 text-left font-bold text-purple-deep/60">Tính năng</th>
              <th class="py-3 text-center font-bold text-pink-dark">Free</th>
              <th class="py-3 text-center font-bold text-pink-dark">Premium</th>
            </tr>
          </thead>
          <tbody>
            {pricing.compare_rows.map((row) => (
              <tr class="border-b border-pink-soft/50">
                <td class="py-3 text-purple-deep/80">{row.label_vi}</td>
                <td class="py-3 text-center text-purple-deep/80">{row.free}</td>
                <td class="py-3 text-center font-bold text-pink-dark">{row.premium}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-12 rounded-3xl border-2 border-pink-soft bg-white p-6 text-center text-sm text-purple-deep/70">
      <p>
        <strong>Lưu ý:</strong> Hiện tại thanh toán chưa tích hợp online. Nâng cấp Premium qua liên hệ:
        <a href={`mailto:${contactEmail}`} class="font-bold text-pink-dark hover:underline">{contactEmail}</a>
      </p>
    </div>
  </section>
</BaseLayout>
