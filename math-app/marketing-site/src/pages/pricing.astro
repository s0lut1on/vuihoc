---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const features = {
  free: [
    { vi: '50 bài học mỗi ngày', en: '50 lessons per day' },
    { vi: 'Đầy đủ 4 phong cách học', en: 'All 4 learning personas' },
    { vi: 'Song ngữ Việt–Anh', en: 'Bilingual Vietnamese–English' },
    { vi: 'Dashboard phụ huynh cơ bản', en: 'Basic parent dashboard' },
    { vi: 'Google Sign-In + Guest', en: 'Google Sign-In + Guest' },
  ],
  premium: [
    { vi: 'Không giới hạn bài học mỗi ngày', en: 'Unlimited lessons per day' },
    { vi: 'Báo cáo tiến bộ hàng tuần qua email', en: 'Weekly progress reports via email' },
    { vi: 'Xuất dữ liệu học tập (CSV)', en: 'Export learning data (CSV)' },
    { vi: 'Nhiều hồ sơ bé trong 1 tài khoản', en: 'Multiple child profiles per account' },
    { vi: 'Hỗ trợ ưu tiên 24/7', en: 'Priority 24/7 support' },
    { vi: 'Sớm nhận nội dung mới', en: 'Early access to new content' },
  ],
};
---
<BaseLayout
  seo={{ title: 'Gói học — Free vs Premium', description: 'HocVui miễn phí 50 bài/ngày. Premium mở khóa không giới hạn và báo cáo nâng cao.', path: '/pricing' }}
  locale="vi"
  pageJsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: 'HocVui Premium',
      description: 'Mở khóa không giới hạn bài học, báo cáo tiến bộ, nhiều hồ sơ bé.',
      brand: { '@type': 'Brand', name: 'HocVui' },
      offers: [
        { '@type': 'Offer', price: '0', priceCurrency: 'VND', name: 'Free', availability: 'https://schema.org/InStock' },
        { '@type': 'Offer', price: '199000', priceCurrency: 'VND', name: 'Premium (tháng)', availability: 'https://schema.org/InStock' },
      ],
    },
  ]}
>
  <Header slot="nav" locale="vi" currentPath="/pricing" />
  <Fragment slot="footer"><Footer locale="vi" /></Fragment>

  <section class="bg-gradient-to-b from-pink-soft to-pink-bg py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-4xl font-extrabold text-purple-deep sm:text-5xl">Gói học</h1>
      <p class="mt-3 text-lg text-purple-deep/70">Bắt đầu miễn phí. Nâng cấp khi cần.</p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      <!-- Free -->
      <div class="rounded-3xl border-2 border-pink-soft bg-white p-8">
        <p class="text-sm font-bold uppercase tracking-wider text-pink-dark">Free</p>
        <p class="mt-2 font-display text-5xl font-extrabold text-purple-deep">0 đ</p>
        <p class="text-sm text-purple-deep/60">mãi mãi</p>
        <ul class="mt-6 space-y-3 text-sm">
          {features.free.map((f) => (
            <li class="flex items-start gap-2 text-purple-deep/80">
              <span class="mt-0.5 text-success">✓</span>
              <span>{f.vi}</span>
            </li>
          ))}
        </ul>
        <a
          href="/app"
          class="mt-8 block w-full rounded-full border-2 border-pink bg-white py-3 text-center text-sm font-bold text-pink-dark transition hover:bg-pink-soft"
        >Bắt đầu miễn phí</a>
      </div>

      <!-- Premium -->
      <div class="relative rounded-3xl border-4 border-pink bg-gradient-to-br from-pink-bg to-cream p-8 shadow-chunky">
        <span class="absolute -top-3 right-6 rounded-full bg-pink px-3 py-1 text-xs font-bold uppercase text-white">Phổ biến</span>
        <p class="text-sm font-bold uppercase tracking-wider text-pink-dark">Premium</p>
        <p class="mt-2 font-display text-5xl font-extrabold text-purple-deep">199K<span class="text-lg">/tháng</span></p>
        <p class="text-sm text-purple-deep/60">hoặc 1,99 triệu/năm (tiết kiệm 17%)</p>
        <ul class="mt-6 space-y-3 text-sm">
          {features.premium.map((f) => (
            <li class="flex items-start gap-2 text-purple-deep/80">
              <span class="mt-0.5 text-pink-dark">✓</span>
              <span>{f.vi}</span>
            </li>
          ))}
        </ul>
        <a
          href="/app"
          class="mt-8 block w-full rounded-full bg-pink py-3 text-center text-sm font-bold text-white shadow-pill transition hover:bg-pink-dark"
        >Nâng cấp ngay</a>
        <p class="mt-3 text-center text-xs text-purple-deep/60">Huỷ bất cứ lúc nào. Hoàn tiền trong 7 ngày.</p>
      </div>
    </div>

    <div class="mt-12 rounded-3xl border-2 border-pink-soft bg-white p-6 text-center text-sm text-purple-deep/70">
      <p>
        <strong>Lưu ý:</strong> Hiện tại thanh toán chưa tích hợp online. Nâng cấp Premium qua liên hệ:
        <a href="mailto:contact@sekklings.com" class="font-bold text-pink-dark hover:underline">contact@sekklings.com</a>
      </p>
    </div>
  </section>
</BaseLayout>
