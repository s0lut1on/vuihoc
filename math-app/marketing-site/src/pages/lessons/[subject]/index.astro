---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

export async function getStaticPaths() {
  const subjectsData = (await import('../../../data/subjects.json')).default;
  const lessonsData = (await import('../../../data/lessons.json')).default;
  const subjects = subjectsData as any[];
  const lessons = lessonsData as Record<string, any>;
  return subjects.map((s) => ({ params: { subject: s.id }, props: { subject: s, lessons } }));
}

const { subject, lessons } = Astro.props;
const gradeList = Array.from({ length: subject.grade_max - subject.grade_min + 1 }, (_, i) => subject.grade_min + i)
  .map((g) => ({ grade: g, n_lessons: lessons[`${subject.id}|${g}`]?.n_lessons ?? 0 }))
  .filter((g) => g.n_lessons > 0);
const total = gradeList.reduce((a, g) => a + g.n_lessons, 0);

const allOutcomes = import.meta.glob('../../../data/outcomes/*.json', { eager: true });
const outcomes = (allOutcomes[`../../../data/outcomes/${subject.id}.json`] as any) ?? null;
---
<BaseLayout
  seo={{
    title: `${subject.name_vi} — ${subject.name_en} cho bé lớp ${subject.grade_min}–${subject.grade_max}`,
    description: `Học ${subject.name_vi.toLowerCase()} cho bé lớp ${subject.grade_min}–${subject.grade_max}. ${total} bài học tương tác, song ngữ.`,
    path: `/lessons/${subject.id}`,
  }}
  locale="vi"
  pageJsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: `${subject.name_vi} - HocVui`,
      description: `Danh sách bài học ${subject.name_vi.toLowerCase()} lớp ${subject.grade_min}-${subject.grade_max}.`,
      isPartOf: { '@id': 'https://sekklings.com/#website' },
      inLanguage: 'vi-VN',
    },
  ]}
>
  <Header slot="nav" locale="vi" currentPath={`/lessons/${subject.id}`} />
  <Fragment slot="footer"><Footer locale="vi" /></Fragment>

  <section class="bg-gradient-to-b from-pink-soft to-pink-bg py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="mb-4 text-sm text-purple-deep/60" aria-label="Breadcrumb">
        <a href="/" class="hover:text-pink-dark">Trang chủ</a> / <a href="/lessons" class="hover:text-pink-dark">Bài học</a> / <span class="font-semibold text-purple-deep">{subject.name_vi}</span>
      </nav>
      <div class="flex items-center gap-4">
        <span class="grid h-20 w-20 place-items-center rounded-3xl text-4xl" style={`background: ${subject.color}`}>{subject.icon}</span>
        <div>
          <h1 class="font-display text-4xl font-extrabold text-purple-deep sm:text-5xl">{subject.name_vi}</h1>
          <p class="mt-1 text-lg text-purple-deep/70">{subject.name_en} · Lớp {subject.grade_min}–{subject.grade_max} · {total} bài học</p>
        </div>
      </div>
    </div>
  </section>

  {outcomes && (
    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl font-extrabold text-purple-deep">Bé sẽ học được gì</h2>
      <p class="mt-2 text-sm text-purple-deep/70">{outcomes.name_en} — theo chương trình GDPT 2018.</p>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        {outcomes.outcomes.map((item: string) => (
          <li class="flex items-start gap-2 rounded-2xl border border-pink-soft bg-white px-4 py-3 text-purple-deep/80">
            <span class="mt-0.5 text-pink-dark">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl font-extrabold text-purple-deep">Chọn lớp</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {gradeList.map((g) => (
        <a
          href={`/lessons/${subject.id}/${g.grade}`}
          class="group rounded-3xl border-2 border-pink-soft bg-white p-6 transition hover:border-pink hover:shadow-chunky-sm"
        >
          <p class="text-sm font-semibold text-purple-deep/60">Lớp {g.grade}</p>
          <p class="mt-1 font-display text-2xl font-extrabold text-purple-deep">{g.n_lessons} bài học</p>
          <p class="mt-3 text-sm font-bold text-pink-dark group-hover:underline">Xem chi tiết →</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
