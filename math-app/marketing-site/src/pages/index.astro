---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE_DESCRIPTION_VI, SITE_TAGLINE_VI, SITE_NAME } from '../lib/i18n';

const features = [
  { icon: '🎯', title: 'Cá nhân hoá theo phong cách', desc: '4 phong cách học — Thành tích, Game, Từng bước, Im lặng — phù hợp với tính cách bé.' },
  { icon: '🌐', title: 'Song ngữ Việt–Anh', desc: 'Mỗi bài học có tiếng Việt và tiếng Anh. Chuyển đổi ngôn ngữ ngay trong bài học.' },
  { icon: '⏰', title: 'Đọc đồng hồ tương tác', desc: 'Mặt đồng hồ CustomPaint cho bài xem giờ. Không slide, không video — học qua thực hành.' },
  { icon: '📈', title: 'BKT thích ứng', desc: 'Câu hỏi tự điều chỉnh độ khó theo năng lực thực tế của bé — không quá dễ, không quá khó.' },
  { icon: '🎓', title: 'Dashboard cho phụ huynh', desc: 'Báo cáo tiến bộ hàng tuần. Mã PIN bảo vệ quyền riêng tư.' },
  { icon: '🆓', title: 'Miễn phí 50 bài/ngày', desc: 'Tài khoản miễn phí học 50 bài mỗi ngày. Nâng cấp Premium không giới hạn.' },
];

const stats = [
  { value: '6,060+', label: 'Bài học' },
  { value: '1,730+', label: 'Câu hỏi' },
  { value: '4', label: 'Phong cách học' },
  { value: '12', label: 'Khối lớp' },
];
---
<BaseLayout
  seo={{
    title: SITE_TAGLINE_VI,
    description: SITE_DESCRIPTION_VI,
    path: '/',
  }}
  locale="vi"
  pageJsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': 'https://sekklings.com/#webpage',
      url: 'https://sekklings.com/',
      name: SITE_NAME,
      isPartOf: { '@id': 'https://sekklings.com/#website' },
      inLanguage: 'vi-VN',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        { '@type': 'Question', name: 'HocVui có miễn phí không?', acceptedAnswer: { '@type': 'Answer', text: 'Có. Tài khoản miễn phí học 50 bài mỗi ngày, không cần thẻ tín dụng.' } },
        { '@type': 'Question', name: 'Bé bao nhiêu tuổi dùng được?', acceptedAnswer: { '@type': 'Answer', text: 'Phù hợp nhất cho bé 5–7 tuổi (lớp 1–2). Có nội dung cho tới lớp 12 nhưng giao diện được thiết kế cho lứa tuổi mầm non và tiểu học.' } },
        { '@type': 'Question', name: 'Có tiếng Việt và tiếng Anh không?', acceptedAnswer: { '@type': 'Answer', text: 'Có. Mỗi bài học đều có cả tiếng Việt và tiếng Anh. Bé có thể chuyển ngôn ngữ bất cứ lúc nào.' } },
        { '@type': 'Question', name: 'Có cần tải app không?', acceptedAnswer: { '@type': 'Answer', text: 'Không. HocVui chạy trên trình duyệt web (PWA) và Android. Không cần App Store.' } },
      ],
    },
  ]}
>
  <Header slot="nav" locale="vi" currentPath="/" />
  <Fragment slot="footer"><Footer locale="vi" /></Fragment>

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-gradient-to-br from-pink-soft via-pink-bg to-cream"></div>
    <div class="absolute inset-0 -z-10 opacity-30" aria-hidden="true">
      <div class="absolute left-[10%] top-20 h-4 w-4 rotate-12 bg-yellow rounded-full"></div>
      <div class="absolute left-[80%] top-40 h-3 w-3 bg-pink rounded-full"></div>
      <div class="absolute left-[30%] top-[60%] h-5 w-5 bg-purple/40 rounded-full"></div>
      <div class="absolute left-[70%] top-[70%] h-3 w-3 bg-success/60 rounded-full"></div>
    </div>
    <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 md:grid-cols-2 md:items-center md:py-28 lg:px-8">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-pink-soft bg-white/70 px-3 py-1 text-xs font-bold text-pink-dark">
          🐸 HocVui · Học vui
        </span>
        <h1 class="mt-5 font-display text-4xl font-extrabold leading-tight text-purple-deep sm:text-5xl lg:text-6xl">
          Toán vui cho bé <span class="text-pink-dark">5–7 tuổi</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-purple-deep/80">
          Hơn 6.000 bài học tương tác, song ngữ Việt–Anh, với 4 phong cách học tập phù hợp với từng bé.
          Học toán không khóc, không nản.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/app"
            class="inline-flex items-center gap-2 rounded-full bg-pink px-6 py-3.5 text-base font-bold text-white shadow-chunky transition hover:bg-pink-dark active:translate-y-1 active:shadow-none"
          >
            Bắt đầu học miễn phí
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="/lessons"
            class="inline-flex items-center gap-2 rounded-full border-2 border-pink-soft bg-white px-6 py-3.5 text-base font-bold text-purple-deep transition hover:border-pink"
          >
            Xem bài học
          </a>
        </div>
        <p class="mt-3 text-sm text-purple-deep/60">
          Không cần thẻ tín dụng · Hoạt động trên mọi thiết bị
        </p>
      </div>

      <div class="relative">
        <div class="absolute -inset-4 -z-10 rounded-3xl bg-gradient-to-br from-pink/20 to-purple/10 blur-2xl"></div>
        <div class="relative grid grid-cols-2 gap-4">
          <div class="rounded-3xl border-4 border-pink-soft bg-white p-6 shadow-chunky-sm">
            <div class="grid h-16 w-16 place-items-center rounded-full bg-gradient-to-br from-[#FFC1DA] to-pink text-3xl">🐸</div>
            <p class="mt-3 font-display text-2xl font-extrabold text-purple-deep">12</p>
            <p class="text-sm text-purple-deep/60">Khối lớp</p>
          </div>
          <div class="rounded-3xl border-4 border-pink-soft bg-white p-6 shadow-chunky-sm">
            <p class="font-display text-2xl font-extrabold text-purple-deep">6,060+</p>
            <p class="text-sm text-purple-deep/60">Bài học</p>
            <div class="mt-3 flex gap-1">
              <span class="h-2 w-2 rounded-full bg-pink"></span>
              <span class="h-2 w-2 rounded-full bg-warning"></span>
              <span class="h-2 w-2 rounded-full bg-success"></span>
              <span class="h-2 w-2 rounded-full bg-purple"></span>
            </div>
          </div>
          <div class="col-span-2 rounded-3xl border-4 border-pink-soft bg-white p-6 shadow-chunky-sm">
            <p class="text-sm font-bold text-purple-deep/70">Phong cách học</p>
            <div class="mt-3 grid grid-cols-4 gap-2 text-center text-xs">
              <div class="rounded-xl bg-achiever-bg px-2 py-3 font-bold text-achiever-text">Thành tích</div>
              <div class="rounded-xl bg-gamer-bg px-2 py-3 font-bold text-gamer-text">Game</div>
              <div class="rounded-xl bg-struggler-bg px-2 py-3 font-bold text-struggler-text">Từng bước</div>
              <div class="rounded-xl bg-silent-bg px-2 py-3 font-bold text-silent-text">Im lặng</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-pink-soft bg-white/60">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-6 px-4 py-10 sm:px-6 md:grid-cols-4 lg:px-8">
      {stats.map((s) => (
        <div class="text-center">
          <p class="font-display text-3xl font-extrabold text-pink-dark sm:text-4xl">{s.value}</p>
          <p class="mt-1 text-sm font-semibold text-purple-deep/70">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Features -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-extrabold text-purple-deep sm:text-4xl">
        Tại sao phụ huynh chọn HocVui?
      </h2>
      <p class="mt-3 text-base text-purple-deep/70">
        Được thiết kế bởi giáo viên tiểu học và kỹ sư giáo dục Việt Nam.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <div class="rounded-3xl border-2 border-pink-soft bg-white p-6 transition hover:border-pink hover:shadow-chunky-sm">
          <div class="grid h-12 w-12 place-items-center rounded-2xl bg-pink-soft text-2xl">{f.icon}</div>
          <h3 class="mt-4 font-display text-lg font-bold text-purple-deep">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-purple-deep/70">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-pink to-purple p-10 sm:p-16">
      <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/10"></div>
      <div class="absolute -bottom-10 -left-10 h-32 w-32 rounded-full bg-white/10"></div>
      <div class="relative grid items-center gap-8 md:grid-cols-2">
        <div>
          <h2 class="font-display text-3xl font-extrabold text-white sm:text-4xl">
            Bé đã sẵn sàng học chưa?
          </h2>
          <p class="mt-3 text-lg text-white/90">
            Tạo tài khoản miễn phí trong 30 giây. Không cần thẻ tín dụng. Học 50 bài mỗi ngày.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 md:justify-end">
          <a
            href="/app"
            class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3.5 text-base font-bold text-pink-dark shadow-lg transition hover:bg-cream"
          >
            Mở ứng dụng →
          </a>
          <a
            href="/pricing"
            class="inline-flex items-center gap-2 rounded-full border-2 border-white/40 bg-white/10 px-6 py-3.5 text-base font-bold text-white backdrop-blur transition hover:bg-white/20"
          >
            Xem gói học
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <Newsletter locale="vi" source="home-page" />
  </section>
</BaseLayout>
