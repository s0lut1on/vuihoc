---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import subjects from '../../../data/subjects.json';
import lessons from '../../../data/lessons.json';

const SUBJECTS = subjects as Array<{ id: string; name_vi: string; name_en: string; icon: string; color: string; grade_min: number; grade_max: number }>;
const LESSONS = lessons as Record<string, { n_lessons: number; grade: number; subject_id: string; sample_titles_vi: string[]; sample_titles_en: string[] }>;

const grouped = SUBJECTS.map((s) => ({
  ...s,
  grades: Array.from({ length: s.grade_max - s.grade_min + 1 }, (_, i) => s.grade_min + i)
    .map((g) => LESSONS[`${s.id}|${g}`])
    .filter(Boolean),
}));

const totalLessons = grouped.reduce((sum, s) => sum + s.grades.reduce((a, g) => a + g.n_lessons, 0), 0);
---
<BaseLayout
  seo={{
    title: 'Math Lessons for Kids 5–7',
    description: 'Bilingual math lessons: numbers, geometry, measurement, logic. 6,000+ interactive lessons for grades 1–12.',
    path: '/en/lessons',
  }}
  locale="en"
>
  <Header slot="nav" locale="en" currentPath="/lessons" />
  <Fragment slot="footer"><Footer locale="en" /></Fragment>

  <section class="bg-gradient-to-b from-pink-soft to-pink-bg py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl font-extrabold text-purple-deep sm:text-5xl">
        Math Lessons
      </h1>
      <p class="mt-3 max-w-2xl text-base text-purple-deep/70">
        Over {totalLessons.toLocaleString('en-US')} interactive math lessons for grades 1–12, organized by subject.
        Every lesson is bilingual Vietnamese–English.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="space-y-8">
      {grouped.map((s) => (
        <article class="rounded-3xl border-2 border-pink-soft bg-white p-6 sm:p-8">
          <div class="flex items-center gap-3">
            <span class="grid h-12 w-12 place-items-center rounded-2xl text-2xl" style={`background: ${s.color}`}>{s.icon}</span>
            <div>
              <h2 class="font-display text-2xl font-extrabold text-purple-deep">{s.name_en}</h2>
              <p class="text-sm text-purple-deep/60">{s.name_vi} · Grade {s.grade_min}–{s.grade_max}</p>
            </div>
          </div>
          <div class="mt-5 grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4">
            {s.grades.map((g) => (
              <a
                href={`/en/lessons/${s.id}/${g.grade}`}
                class="group flex items-center justify-between rounded-2xl border-2 border-pink-soft bg-pink-bg px-3 py-2.5 text-sm font-semibold text-purple-deep transition hover:border-pink hover:bg-white"
              >
                <span>Grade {g.grade}</span>
                <span class="rounded-full bg-white px-2 py-0.5 text-xs font-bold text-pink-dark group-hover:bg-pink group-hover:text-white">{g.n_lessons}</span>
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
