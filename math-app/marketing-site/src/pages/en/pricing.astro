---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import pricing from '../../../../pricing.json';

const free = pricing.tiers.find((t) => t.id === 'free')!;
const premium = pricing.tiers.find((t) => t.id === 'premium_monthly')!;
const yearly = pricing.tiers.find((t) => t.id === 'premium_yearly')!;
const contactEmail = pricing.contact_email as string;

const formatPrice = (n: number) => {
  if (n === 0) return '$0';
  if (n >= 1000000) {
    const v = (n / 1000000).toFixed(2).replace(/\.00$/, '');
    return `$${v}M`;
  }
  return `$${Math.round(n / 1000)}K`;
};
---
<BaseLayout
  seo={{ title: 'Pricing — Free vs Premium', description: 'HocVui free tier: unlimited lessons. Premium: email reports, multi-child, CSV export. From 39K VND/month.', path: '/en/pricing' }}
  locale="en"
  pageJsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: 'HocVui Premium',
      description: 'Unlock weekly email reports, multiple child profiles, CSV export, priority support.',
      brand: { '@type': 'Brand', name: 'HocVui' },
      offers: [
        { '@type': 'Offer', price: '0', priceCurrency: 'USD', name: 'Free', availability: 'https://schema.org/InStock', priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'VND', price: 0 } },
        { '@type': 'Offer', price: '1.59', priceCurrency: 'USD', name: 'Premium (monthly)', availability: 'https://schema.org/InStock', priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'VND', price: 39000 } },
        { '@type': 'Offer', price: '15.90', priceCurrency: 'USD', name: 'Premium (yearly)', availability: 'https://schema.org/InStock', priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'VND', price: 390000 } },
      ],
    },
  ]}
>
  <Header slot="nav" locale="en" currentPath="/pricing" />
  <Fragment slot="footer"><Footer locale="en" /></Fragment>

  <section class="bg-gradient-to-b from-pink-soft to-pink-bg py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-4xl font-extrabold text-purple-deep sm:text-5xl">Pricing</h1>
      <p class="mt-3 text-lg text-purple-deep/70">Free to start. Upgrade when you need more.</p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-3">
      <!-- Free -->
      <div class="rounded-3xl border-2 border-pink-soft bg-white p-8">
        <p class="text-sm font-bold uppercase tracking-wider text-pink-dark">{free.name_en}</p>
        <p class="mt-2 font-display text-5xl font-extrabold text-purple-deep">{formatPrice(free.price)}</p>
        <p class="text-sm text-purple-deep/60">{free.price_period_en}</p>
        <ul class="mt-6 space-y-3 text-sm">
          {free.features.map((f) => (
            <li class="flex items-start gap-2 text-purple-deep/80">
              <span class="mt-0.5 text-success">✓</span>
              <span>{f.text_en}</span>
            </li>
          ))}
        </ul>
        <a
          href="/en/app"
          class="mt-8 block w-full rounded-full border-2 border-pink bg-white py-3 text-center text-sm font-bold text-pink-dark transition hover:bg-pink-soft"
        >Get started free</a>
      </div>

      <!-- Premium monthly -->
      <div class="relative rounded-3xl border-4 border-pink bg-gradient-to-br from-pink-bg to-cream p-8 shadow-chunky">
        {premium.popular && <span class="absolute -top-3 right-6 rounded-full bg-pink px-3 py-1 text-xs font-bold uppercase text-white">Popular</span>}
        <p class="text-sm font-bold uppercase tracking-wider text-pink-dark">{premium.name_en}</p>
        <p class="mt-2 font-display text-5xl font-extrabold text-purple-deep">{formatPrice(premium.price)}<span class="text-lg">/month</span></p>
        <p class="text-sm text-purple-deep/60">{formatPrice(yearly.price)}/year (save 17%)</p>
        <ul class="mt-6 space-y-3 text-sm">
          {premium.features.map((f) => (
            <li class="flex items-start gap-2 text-purple-deep/80">
              <span class="mt-0.5 text-pink-dark">✓</span>
              <span>{f.text_en}</span>
            </li>
          ))}
        </ul>
        <a
          href="/en/app"
          class="mt-8 block w-full rounded-full bg-pink py-3 text-center text-sm font-bold text-white shadow-pill transition hover:bg-pink-dark"
        >Upgrade now</a>
        <p class="mt-3 text-center text-xs text-purple-deep/60">Cancel anytime. 7-day refund.</p>
      </div>

      <!-- Premium yearly -->
      <div class="rounded-3xl border-2 border-pink-soft bg-cream p-8">
        <p class="text-sm font-bold uppercase tracking-wider text-pink-dark">{yearly.name_en}</p>
        <p class="mt-2 font-display text-5xl font-extrabold text-purple-deep">{formatPrice(yearly.price)}<span class="text-lg">/year</span></p>
        <p class="text-sm text-success">Save 17% vs monthly</p>
        <ul class="mt-6 space-y-3 text-sm">
          {yearly.features.map((f) => (
            <li class="flex items-start gap-2 text-purple-deep/80">
              <span class="mt-0.5 text-pink-dark">✓</span>
              <span>{f.text_en}</span>
            </li>
          ))}
        </ul>
        <a
          href="/en/app"
          class="mt-8 block w-full rounded-full border-2 border-pink bg-white py-3 text-center text-sm font-bold text-pink-dark transition hover:bg-pink-soft"
        >Save 17%</a>
      </div>
    </div>

    <!-- Comparison table -->
    <div class="mt-12 rounded-3xl border-2 border-pink-soft bg-white p-6">
      <h2 class="text-center font-display text-2xl font-extrabold text-purple-deep">Detailed comparison</h2>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b-2 border-pink-soft">
              <th class="py-3 text-left font-bold text-purple-deep/60">Feature</th>
              <th class="py-3 text-center font-bold text-pink-dark">Free</th>
              <th class="py-3 text-center font-bold text-pink-dark">Premium</th>
            </tr>
          </thead>
          <tbody>
            {pricing.compare_rows.map((row) => (
              <tr class="border-b border-pink-soft/50">
                <td class="py-3 text-purple-deep/80">{row.label_en}</td>
                <td class="py-3 text-center text-purple-deep/80">{row.free}</td>
                <td class="py-3 text-center font-bold text-pink-dark">{row.premium}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-12 rounded-3xl border-2 border-pink-soft bg-white p-6 text-center text-sm text-purple-deep/70">
      <p>
        <strong>Note:</strong> Online payment is not yet integrated. Upgrade to Premium via:
        <a href={`mailto:${contactEmail}`} class="font-bold text-pink-dark hover:underline">{contactEmail}</a>
      </p>
    </div>
  </section>
</BaseLayout>
