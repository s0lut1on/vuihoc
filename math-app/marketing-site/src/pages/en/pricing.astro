---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout
  seo={{ title: 'Pricing — Free vs Premium', description: 'HocVui free tier: 50 lessons per day. Premium: unlimited + reports + multi-child.', path: '/en/pricing' }}
  locale="en"
>
  <Header slot="nav" locale="en" currentPath="/pricing" />
  <Fragment slot="footer"><Footer locale="en" /></Fragment>

  <section class="bg-gradient-to-b from-pink-soft to-pink-bg py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-4xl font-extrabold text-purple-deep sm:text-5xl">Pricing</h1>
      <p class="mt-3 text-lg text-purple-deep/70">Free to start. Upgrade when you need more.</p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-3xl border-2 border-pink-soft bg-white p-8">
        <p class="text-sm font-bold uppercase tracking-wider text-pink-dark">Free</p>
        <p class="mt-2 font-display text-5xl font-extrabold text-purple-deep">$0</p>
        <p class="text-sm text-purple-deep/60">forever</p>
        <ul class="mt-6 space-y-3 text-sm">
          {['50 lessons per day', 'All 4 learning personas', 'Bilingual VI–EN', 'Basic parent dashboard', 'Google Sign-In + Guest'].map((f) => (
            <li class="flex items-start gap-2 text-purple-deep/80"><span class="mt-0.5 text-success">✓</span><span>{f}</span></li>
          ))}
        </ul>
        <a href="/app" class="mt-8 block w-full rounded-full border-2 border-pink bg-white py-3 text-center text-sm font-bold text-pink-dark transition hover:bg-pink-soft">Start free</a>
      </div>
      <div class="relative rounded-3xl border-4 border-pink bg-gradient-to-br from-pink-bg to-cream p-8 shadow-chunky">
        <span class="absolute -top-3 right-6 rounded-full bg-pink px-3 py-1 text-xs font-bold uppercase text-white">Popular</span>
        <p class="text-sm font-bold uppercase tracking-wider text-pink-dark">Premium</p>
        <p class="mt-2 font-display text-5xl font-extrabold text-purple-deep">$7.99<span class="text-lg">/mo</span></p>
        <p class="text-sm text-purple-deep/60">or $79/yr (save 17%)</p>
        <ul class="mt-6 space-y-3 text-sm">
          {['Unlimited lessons per day', 'Weekly progress reports via email', 'Export learning data (CSV)', 'Multiple child profiles per account', 'Priority 24/7 support', 'Early access to new content'].map((f) => (
            <li class="flex items-start gap-2 text-purple-deep/80"><span class="mt-0.5 text-pink-dark">✓</span><span>{f}</span></li>
          ))}
        </ul>
        <a href="/app" class="mt-8 block w-full rounded-full bg-pink py-3 text-center text-sm font-bold text-white shadow-pill transition hover:bg-pink-dark">Upgrade now</a>
        <p class="mt-3 text-center text-xs text-purple-deep/60">Cancel anytime. 7-day refund.</p>
      </div>
    </div>
  </section>
</BaseLayout>
