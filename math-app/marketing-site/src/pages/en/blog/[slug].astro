---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import subjectsData from '../../../data/subjects.json';

const subjects = subjectsData as Array<{ id: string; name_vi: string; name_en: string; icon: string; color: string }>;
const subjectMap = new Map(subjects.map((s) => [s.id, s]));

export async function getStaticPaths() {
  const posts = await getCollection('blog-en');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout
  seo={{
    title: post.data.title,
    description: post.data.description,
    path: `/en/blog/${post.id}`,
    ogImage: post.data.heroImage ? `/${post.data.heroImage}` : 'og-image-en.png',
    ogType: 'article',
    publishedTime: post.data.publishedTime,
    modifiedTime: post.data.modifiedTime,
  }}
  locale="en"
  pageJsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    image: post.data.heroImage ? `https://sekklings.com/${post.data.heroImage}` : 'https://sekklings.com/brand/og-image-en.png',
    datePublished: post.data.publishedTime,
    dateModified: post.data.modifiedTime ?? post.data.publishedTime,
    author: { '@type': 'Organization', name: post.data.author, url: 'https://sekklings.com' },
    publisher: { '@id': 'https://sekklings.com/#organization' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://sekklings.com/en/blog/${post.id}` },
    keywords: post.data.tags.join(', '),
    inLanguage: 'en-US',
  }]}
>
  <Header slot="nav" locale="en" currentPath="/blog" />
  <Fragment slot="footer"><Footer locale="en" /></Fragment>

  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <nav class="mb-6 text-sm text-purple-deep/60" aria-label="Breadcrumb">
      <a href="/en" class="hover:text-pink-dark">Home</a> / <a href="/en/blog" class="hover:text-pink-dark">Blog</a>
    </nav>

    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-3 text-xs text-purple-deep/60">
        <time datetime={post.data.publishedTime}>{formatDate(post.data.publishedTime)}</time>
        {post.data.tags.length > 0 && <><span>·</span><span>{post.data.tags.slice(0, 3).join(', ')}</span></>}
        <span>·</span>
        <span>{post.data.author}</span>
      </div>
      <h1 class="mt-3 font-display text-3xl font-extrabold leading-tight text-purple-deep sm:text-4xl">
        {post.data.title}
      </h1>
      <p class="mt-3 text-lg text-purple-deep/80">{post.data.description}</p>
    </header>

    {post.data.heroImage && (
      <img
        src={`/${post.data.heroImage}`}
        alt={post.data.title}
        class="mb-8 w-full rounded-3xl"
        loading="eager"
        width="1200"
        height="630"
      />
    )}

    <div class="prose prose-lg prose-purple max-w-none">
      <Content />
    </div>

    {post.data.relatedLessons.length > 0 && (
      <section class="mt-12 rounded-3xl border-2 border-pink-soft bg-pink-bg p-6">
        <h2 class="font-display text-xl font-extrabold text-purple-deep">Related lessons</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {post.data.relatedLessons.map((rl) => {
            const s = subjectMap.get(rl.subject);
            return (
              <li>
                <a
                  href={`/en/lessons/${rl.subject}/${rl.grade}/`}
                  class="group flex items-center gap-3 rounded-2xl border-2 border-pink-soft bg-white px-4 py-3 transition hover:border-pink"
                >
                  {s && (
                    <span class="grid h-10 w-10 place-items-center rounded-xl text-xl" style={`background: ${s.color}`}>
                      {s.icon}
                    </span>
                  )}
                  <div>
                    <p class="text-xs text-purple-deep/60">Grade {rl.grade}</p>
                    <p class="font-bold text-purple-deep group-hover:text-pink-dark">
                      {s?.name_en ?? rl.subject}
                    </p>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <section class="mt-12 rounded-3xl bg-gradient-to-br from-pink to-purple p-8 text-center">
      <h2 class="font-display text-2xl font-extrabold text-white sm:text-3xl">Try HocVui free</h2>
      <p class="mt-2 text-white/90">6,000+ bilingual math lessons.</p>
      <a href="/app" class="mt-4 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-bold text-pink-dark shadow-lg transition hover:bg-cream">
        Open the app →
      </a>
    </section>

    <nav class="mt-10 text-sm">
      <a href="/en/blog" class="font-semibold text-pink-dark hover:underline">← Back to Blog</a>
    </nav>
  </article>
</BaseLayout>
