---
/**
 * BaseLayout — full <head> SEO surface for HocVui marketing site.
 *
 * Handles:
 *   - <title>, <meta description>, robots
 *   - OpenGraph (vi_VN default + en_US alternate)
 *   - Twitter card
 *   - hreflang for vi/en + x-default
 *   - canonical URL
 *   - JSON-LD (Organization + WebSite + SoftwareApplication + page-specific)
 *   - theme-color, manifest, favicon, apple-touch
 *   - Critical CSS preload + bootstrap script preload
 */
import { SEOProps, SITE, SITE_NAME, SITE_TAGLINE_VI, SITE_TAGLINE_EN, alternateUrl, localeFromPath } from '../lib/i18n';

interface Props {
  seo: SEOProps;
  locale?: 'vi' | 'en';
  /** Slot for page-specific JSON-LD (overrides seo.jsonLd if both set) */
  pageJsonLd?: object[];
}

const { seo, locale: localeProp, pageJsonLd } = Astro.props;
const locale = localeProp ?? localeFromPath(Astro.url.pathname);
const isEn = locale === 'en';

const canonical = new URL(seo.path, SITE).toString();
const viAlt = alternateUrl(seo.path, 'vi');
const enAlt = alternateUrl(seo.path, 'en');
const ogImage = seo.ogImage?.startsWith('http')
  ? seo.ogImage
  : `${SITE}/${seo.ogImage ?? (isEn ? 'brand/og-image-en.png' : 'brand/og-image-vi.png')}`;
const ogType = seo.ogType ?? 'website';

// Default JSON-LD: Organization + WebSite + SoftwareApplication (site-wide, on every page)
const siteJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE}#organization`,
    name: SITE_NAME,
    url: SITE,
    logo: `${SITE}/brand/logo.svg`,
    sameAs: [
      'https://www.facebook.com/hocvui',
      'https://www.youtube.com/@hocvui',
      'https://www.tiktok.com/@hocvui',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE}#website`,
    url: SITE,
    name: SITE_NAME,
    inLanguage: ['vi-VN', 'en-US'],
    publisher: { '@id': `${SITE}#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': `${SITE}#app`,
    name: SITE_NAME,
    url: `${SITE}/app`,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Web, Android',
    description: isEn ? SITE_TAGLINE_EN : SITE_TAGLINE_VI,
    offers: [
      { '@type': 'Offer', price: '0', priceCurrency: 'VND', name: 'Free tier' },
      { '@type': 'Offer', price: '199000', priceCurrency: 'VND', name: 'Premium' },
    ],
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '4.8',
      ratingCount: '1280',
      bestRating: '5',
      worstRating: '1',
    },
    author: { '@id': `${SITE}#organization` },
  },
];

const jsonLdBlocks = [...siteJsonLd, ...(pageJsonLd ?? seo.jsonLd ?? [])];

// Pre-compute the final <title>: "%s | HocVui" — but home is just "HocVui"
const fullTitle = seo.path === '/' && locale === 'vi'
  ? `${SITE_NAME} — ${SITE_TAGLINE_VI}`
  : seo.path === '/' && locale === 'en'
    ? `${SITE_NAME} — ${SITE_TAGLINE_EN}`
    : `${seo.title} | ${SITE_NAME}`;
---
<!doctype html>
<html lang={isEn ? 'en' : 'vi'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="generator" content={Astro.generator} />

    <!-- Title + description -->
    <title>{fullTitle}</title>
    <meta name="description" content={seo.description} />

    {seo.noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Canonical + hreflang -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="vi" href={viAlt} />
    <link rel="alternate" hreflang="en" href={enAlt} />
    <link rel="alternate" hreflang="x-default" href={viAlt} />

    <!-- Favicons + manifest -->
    <link rel="icon" type="image/x-icon" href="/brand/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#FF6B9D" />
    <meta name="color-scheme" content="light" />

    <!-- iOS PWA -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="HocVui" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="format-detection" content="telephone=no" />

    <!-- OpenGraph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.title} />
    <meta property="og:locale" content={isEn ? 'en_US' : 'vi_VN'} />
    <meta property="og:locale:alternate" content={isEn ? 'vi_VN' : 'en_US'} />
    {seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime} />}
    {seo.modifiedTime && <meta property="article:modified_time" content={seo.modifiedTime} />}

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={seo.title} />

    <!-- Performance: preconnect to font + image origins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
    />

    <!-- JSON-LD blocks -->
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <!-- Umami analytics (self-hosted, cookie-free, GDPR-friendly) -->
    {import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
      <script
        async
        defer
        data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}
        src={`${import.meta.env.PUBLIC_UMAMI_URL || 'https://sekklings.com/umami'}/script.js`}
      />
    )}

    <slot name="head" />
  </head>
  <body class="min-h-screen bg-pink-bg font-sans text-purple-deep antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-pink focus:px-4 focus:py-2 focus:text-white">
      {isEn ? 'Skip to main content' : 'Bỏ qua đến nội dung chính'}
    </a>
    <slot name="nav" />
    <main id="main"><slot /></main>
    <slot name="footer" />
  </body>
</html>
