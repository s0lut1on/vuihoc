---
import { Locale, alternateUrl, t, type I18nEntry } from '../lib/i18n';
import { NAV } from '../lib/nav';

interface Props {
  locale: Locale;
  /** Path relative to site root (no locale prefix) for current page, used to compute EN alternate */
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const isEn = locale === 'en';
const enUrl = alternateUrl(currentPath, 'en');
const viUrl = alternateUrl(currentPath, 'vi');
const nav = NAV;
---
<header class="sticky top-0 z-40 border-b border-pink-soft bg-pink-bg/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href={isEn ? '/en' : '/'} class="flex items-center gap-2.5 font-display text-xl font-extrabold text-purple-deep">
      <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-[#FFC1DA] to-pink text-2xl shadow-pill">🐸</span>
      <span>HocVui</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      <a href={isEn ? '/en/lessons' : '/lessons'} class="rounded-full px-3 py-2 text-sm font-semibold text-purple-deep/80 transition hover:bg-pink-soft hover:text-purple-deep">
        {t(nav.lessons, locale)}
      </a>
      <a href={isEn ? '/en/personas' : '/personas'} class="rounded-full px-3 py-2 text-sm font-semibold text-purple-deep/80 transition hover:bg-pink-soft hover:text-purple-deep">
        {t({ vi: 'Phong cách', en: 'Personas' }, locale)}
      </a>
      <a href={isEn ? '/en/parents' : '/parents'} class="rounded-full px-3 py-2 text-sm font-semibold text-purple-deep/80 transition hover:bg-pink-soft hover:text-purple-deep">
        {t(nav.parents, locale)}
      </a>
      <a href={isEn ? '/en/pricing' : '/pricing'} class="rounded-full px-3 py-2 text-sm font-semibold text-purple-deep/80 transition hover:bg-pink-soft hover:text-purple-deep">
        {t(nav.pricing, locale)}
      </a>
      <a href={isEn ? '/en/blog' : '/blog'} class="rounded-full px-3 py-2 text-sm font-semibold text-purple-deep/80 transition hover:bg-pink-soft hover:text-purple-deep">
        {t(nav.blog, locale)}
      </a>
    </nav>

    <div class="flex items-center gap-2">
      <!-- Language toggle -->
      <a
        href={isEn ? viUrl : enUrl}
        hreflang={isEn ? 'vi' : 'en'}
        rel="alternate"
        class="hidden rounded-full border border-pink-soft bg-white/60 px-3 py-1.5 text-xs font-bold text-purple-deep transition hover:bg-white sm:inline-flex"
        aria-label={isEn ? 'Switch to Vietnamese' : 'Switch to English'}
      >
        {isEn ? '🇻🇳 VI' : '🇺🇸 EN'}
      </a>

      <a
        href="/app"
        class="inline-flex items-center gap-1.5 rounded-full bg-pink px-4 py-2 text-sm font-bold text-white shadow-pill transition hover:bg-pink-dark active:translate-y-0.5 active:shadow-none"
      >
        {t(nav.start, locale)}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <!-- Mobile nav -->
  <nav class="border-t border-pink-soft bg-white/60 md:hidden" aria-label="Mobile">
    <div class="flex overflow-x-auto px-2 py-1.5">
      <a href={isEn ? '/en/lessons' : '/lessons'} class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-semibold text-purple-deep/80 hover:bg-pink-soft">{t(nav.lessons, locale)}</a>
      <a href={isEn ? '/en/personas' : '/personas'} class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-semibold text-purple-deep/80 hover:bg-pink-soft">{t({ vi: 'Phong cách', en: 'Personas' }, locale)}</a>
      <a href={isEn ? '/en/parents' : '/parents'} class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-semibold text-purple-deep/80 hover:bg-pink-soft">{t(nav.parents, locale)}</a>
      <a href={isEn ? '/en/pricing' : '/pricing'} class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-semibold text-purple-deep/80 hover:bg-pink-soft">{t(nav.pricing, locale)}</a>
      <a href={isEn ? '/en/blog' : '/blog'} class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-semibold text-purple-deep/80 hover:bg-pink-soft">{t(nav.blog, locale)}</a>
      <a href={isEn ? viUrl : enUrl} class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-bold text-pink-dark hover:bg-pink-soft">{isEn ? '🇻🇳 VI' : '🇺🇸 EN'}</a>
    </div>
  </nav>
</header>
