# ──────────────────────────────────────────────────────────────────────
# VPS deploy config — copy to .env.deploy (gitignored) and fill in.
#
# All vars can also be passed inline:
#   VPS_HOST=user@host ./scripts/deploy-vps.sh status
#
# Inline env vars always override values from this file.
# ──────────────────────────────────────────────────────────────────────

# VPS connection ──────────────────────────────────────────────────────
# User@host. Default: deploy@194.233.94.167 (your actual VPS).
VPS_HOST=deploy@194.233.94.167

# Remote project directory. ~ expands to VPS user's home.
VPS_DIR=~/math-app/math-app

# SSH key path. EMPTY = use ssh-agent (recommended).
# Set to a file path ONLY if your key isn't in the agent:
#   VPS_SSH_KEY=~/.ssh/id_rsa
VPS_SSH_KEY=

# Google OAuth web client ID (passed as --dart-define to Flutter build).
# Get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=1026978886898-cpqjll5m4b2ds8h7udb2i0j3ogq1u5um.apps.googleusercontent.com

# Flutter SDK path (used by `deploy-vps.sh sync` for local build).
FLUTTER_BIN=/home/s0lut1on/flutter/bin/flutter

# APP_VERSION shown in home-screen footer. Empty = git short SHA.
APP_VERSION=

# Compose file on the VPS. Most users don't need to change this.
COMPOSE_FILE=docker-compose.prod.yml

# ─── Optional: skip flags ───────────────────────────────────────────
# SKIP_FRONTEND=1    # don't build Flutter web (use existing build/web)
# SKIP_BACKEND=1     # don't rebuild backend images
# NO_CACHE=1         # force docker build --no-cache
# SERVICES=auth-service   # only build/restart this service

# ─── Optional: per-subcommand overrides ─────────────────────────────
# Pass these inline before the subcommand:
#   SERVICES=auth-service ./scripts/deploy-vps.sh build
#   SERVICES=auth-service ./scripts/deploy-vps.sh logs
#   SKIP_FRONTEND=1 ./scripts/deploy-vps.sh sync
