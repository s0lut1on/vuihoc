# Production Environment Variables for Math Learning App
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is already in .gitignore.
#
# For Option A (existing reverse proxy):
#   - All services bind to loopback (127.0.0.1) only
#   - Nginx/Apache/Caddy routes traffic to loopback ports
#
# For dedicated VPS (Traefik):
#   - Remove 127.0.0.1: prefixes from ports in docker-compose.yml
#   - Use docker-compose.yml directly (not docker-compose.prod.existing-proxy.yml)

# =============================================================================
# REQUIRED: JWT Secret (used by all services to sign/verify tokens)
# Must be at least 32 characters. Generate with:
#   openssl rand -base64 32
# =============================================================================
JWT_SECRET=REPLACE_THIS_WITH_A_STRONG_256_BIT_KEY_MIN_32_CHARS

# =============================================================================
# REQUIRED: Google OAuth Client ID
# Get from https://console.cloud.google.com/apis/credentials
# Must match the client ID configured in the Flutter app
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# =============================================================================
# OPTIONAL: Anthropic API Key (used by question-bank service for AI question gen)
# Get from https://console.anthropic.com/settings/keys
# If omitted, AI question generation features are disabled
# =============================================================================
# ANTHROPIC_API_KEY=sk-ant-api03-...

# =============================================================================
# REQUIRED: MinIO (S3-compatible storage) credentials
# Used for media uploads. These are also the MinIO root credentials.
# Must be set even if you don't plan to use media uploads, because the
# media service connects to MinIO on startup.
# =============================================================================
MINIO_ACCESS_KEY=strong_random_access_key_min_8_chars
MINIO_SECRET_KEY=strong_random_secret_key_min_8_chars

# =============================================================================
# Database URLs (used by backend services)
# Each service connects to its own Postgres container.
# The DB hostnames match the service names in docker-compose (e.g., auth-db).
#
# For Option A (existing proxy) and dedicated VPS, the format is:
#   postgres://DB_USER:DB_PASS@DB_HOST:5432/DB_NAME
# =============================================================================

# Auth Service Database
AUTH_DB_URL=postgres://auth_user:auth_pass@auth-db:5432/auth_db
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASS=auth_pass

# User Service Database
USER_DB_URL=postgres://user_user:user_pass@user-db:5432/user_db
USER_DB_NAME=user_db
USER_DB_USER=user_user
USER_DB_PASS=user_pass

# Content Service Database
CONTENT_DB_URL=postgres://content_user:content_pass@content-db:5432/content_db
CONTENT_DB_NAME=content_db
CONTENT_DB_USER=content_user
CONTENT_DB_PASS=content_pass

# Progress Service Database
PROGRESS_DB_URL=postgres://progress_user:progress_pass@progress-db:5432/progress_db
PROGRESS_DB_NAME=progress_db
PROGRESS_DB_USER=progress_user
PROGRESS_DB_PASS=progress_pass

# Notification Service Database
NOTIFICATION_DB_URL=postgres://postgres:postgres@notification-db:5432/notification_db
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=postgres
NOTIFICATION_DB_PASS=postgres

# Media Service Database
MEDIA_DB_URL=postgres://postgres:postgres@media-db:5432/media_db
MEDIA_DB_NAME=media_db
MEDIA_DB_USER=postgres
MEDIA_DB_PASS=postgres

# Question Bank Service Database
QB_DB_URL=postgres://qb_user:qb_pass@qb-db:5432/qb_db
QB_DB_NAME=qb_db
QB_DB_USER=qb_user
QB_DB_PASS=qb_pass

# =============================================================================
# OPTIONAL: Owner/Repo path (used by docker-compose.ghcr.yml for GHCR images)
# In dedicated VPS mode with CI/CD, this tells compose where to pull from.
# Defaults to your-username/math-app; set the real OWNER/REPO from your GitHub.
# =============================================================================
# OWNER_REPO=your-username/math-app

# =============================================================================
# OPTIONAL: Domain (used by Traefik labels in dedicated VPS mode)
# Not needed for Option A (existing proxy) — proxy handles domains there.
# =============================================================================
# DOMAIN=yourdomain.com

# =============================================================================
# OPTIONAL: Let's Encrypt email (used by Traefik for dedicated VPS SSL)
# Required when using Traefik (docker-compose.prod.yml) for SSL cert notifications
# Not needed for Option A (existing proxy).
# =============================================================================
# LETSENCRYPT_EMAIL=admin@yourdomain.com
